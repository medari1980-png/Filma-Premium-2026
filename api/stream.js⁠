export default async function handler(req, res) {
  const { path: streamPath } = req.query;

  if (!streamPath) {
    return res.status(400).send("Mungon rruga e stream-it");
  }

  // Adresa bazë e serverit dhe pjesa e mesit e linkut tuaj
  const serverBase = "http://client.newborntv.xyz:8080";
  const middlePath = "SltvadmminYellowStar/jkn8r28jkn821311";

  // Kredencialet e Serverit 1 (Kryesor) - Vendos user/pass të parë këtu
  const user1 = "USER_I_PARE";
  const pass1 = "PASS_I_PARE";

  // Kredencialet e Serverit 2 (Rezervë) - Vendos user/pass të dytë këtu
  const user2 = "USER_I_DYTE";
  const pass2 = "PASS_I_DYTE";

  // Ndërtojmë linqet automatikisht duke përfshirë strukturën e saktë
  const url1 = `${serverBase}/${middlePath}/${user1}/${pass1}/${streamPath}`;
  const url2 = `${serverBase}/${middlePath}/${user2}/${pass2}/${streamPath}`;

  const checkStream = async (url) => {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 3000);

      const response = await fetch(url, {
        method: 'GET',
        headers: { 'User-Agent': 'VLC/3.0.18 LibVLC/3.0.18' },
        signal: controller.signal
      });
      
      clearTimeout(timeoutId);
      return response.ok;
    } catch (err) {
      return false;
    }
  };

  // Provo të parin, nëse s'bën kalo tek i dyti
  if (await checkStream(url1)) {
    return res.redirect(302, url1);
  }

  return res.redirect(302, url2);
}
